# ==========================================
# NEXUS IoT - Environment Template
# Copy ke .env lalu isi SECRET_KEY & IOT_PASSWORD
# ==========================================

FLASK_ENV=production
HOST=0.0.0.0
PORT=5000
DEBUG=False
WORKERS=2
THREADS=4

# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
SESSION_COOKIE_SECURE=False
SESSION_LIFETIME_HOURS=24

MAX_CONTENT_LENGTH=2097152
ENABLE_HSTS=False
CSP_REPORT_ONLY=False

IOT_USERNAME=admin
IOT_PASSWORD=

DB_PATH=database/iot.db
DATA_RETENTION_DAYS=30

BACKUP_ENABLED=True
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=backup

OFFLINE_TIMEOUT=900
CHECK_INTERVAL=60
DEFAULT_EXPECTED_INTERVAL=60
DEFAULT_OFFLINE_SEVERITY=danger

BACKGROUND_TASKS_ENABLED=True
NEXUS_LOCK_DIR=/tmp

CORS_ORIGINS=http://localhost:5008,http://127.0.0.1:5008

RATE_LIMIT_DEFAULT=200 per minute
RATE_LIMIT_DATA=60 per minute
RATE_LIMIT_LOGIN=5 per minute

LOG_LEVEL=INFO
LOG_FILE=logs/nexus.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

ALERT_TEMP_HEALTHY_MIN=6
ALERT_TEMP_HEALTHY_MAX=28
ALERT_TEMP_WARNING_MIN=0
ALERT_TEMP_WARNING_MAX=32
ALERT_TEMP_DANGER_MIN=-10
ALERT_TEMP_DANGER_MAX=40

NGINX_PORT=5008

# ---------- Notifikasi Telegram (P1-C) ----------
NOTIFY_ENABLED=False
NOTIFY_MIN_SEVERITY=warning
NOTIFY_ON_CLEARED=True

TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=