# ---------- Server ----------
HOST=0.0.0.0
PORT=5000
FLASK_ENV=production
DEBUG=False

# ---------- Security ----------
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32
SESSION_COOKIE_SECURE=False
SESSION_LIFETIME_HOURS=24

# ---------- Authentication ----------
IOT_USERNAME=admin
IOT_PASSWORD=CHANGE_ME_strong_password

# ---------- Database ----------
DB_PATH=database/iot.db
DATA_RETENTION_DAYS=30

# ---------- Backup ----------
BACKUP_ENABLED=True
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=backup

# ---------- Device Monitoring ----------
OFFLINE_TIMEOUT=900
CHECK_INTERVAL=60
BACKGROUND_TASKS_ENABLED=True

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5000

# ---------- Rate Limiting ----------
RATE_LIMIT_DEFAULT=200 per minute
RATE_LIMIT_DATA=60 per minute
RATE_LIMIT_LOGIN=5 per minute

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_FILE=logs/nexus.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ---------- Alerts ----------
ALERT_TEMP_HEALTHY_MIN=6
ALERT_TEMP_HEALTHY_MAX=28
ALERT_TEMP_WARNING_MIN=0
ALERT_TEMP_WARNING_MAX=32
ALERT_TEMP_DANGER_MIN=-10
ALERT_TEMP_DANGER_MAX=40

# ---------- Notifications (Telegram) ----------
NOTIFY_ENABLED=False
NOTIFY_MIN_SEVERITY=warning
NOTIFY_ON_CLEARED=True
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Nginx ----------
NGINX_PORT=5008