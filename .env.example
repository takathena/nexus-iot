# ==========================================================
# NEXUS IoT — Environment Variables (LENGKAP)
# Generate SECRET_KEY:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# ==========================================================

# ---------- SERVER ----------
HOST=0.0.0.0
PORT=5000
# production = SESSION_COOKIE_SECURE=True (BUTUH HTTPS!)
# development = debug mode, cookie non-secure (untuk HTTP/lokal)
FLASK_ENV=production
DEBUG=False
# Dipakai hanya kalau ada reverse proxy Nginx (di luar Python)
NGINX_PORT=5008

# ---------- SECURITY ----------
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32_min_32_chars
SESSION_COOKIE_SECURE=False
SESSION_LIFETIME_HOURS=24
SESSION_IDLE_TIMEOUT_MINUTES=120
# 2 MB default. Set lebih besar jika payload sensor besar (dalam bytes)
MAX_CONTENT_LENGTH=2097152
# Aktifkan hanya jika sudah pakai HTTPS (production proper)
ENABLE_HSTS=False
# True = CSP hanya report, tidak blokir (untuk debugging)
CSP_REPORT_ONLY=False

# ---------- CSP OVERRIDES (opsional) ----------
# Kosongkan untuk pakai default dari config.py
# CSP_SCRIPT_SRC='self' 'unsafe-inline' https://cdnjs.cloudflare.com https://unpkg.com https://cdn.jsdelivr.net https://fonts.googleapis.com
# CSP_STYLE_SRC='self' 'unsafe-inline' https://cdnjs.cloudflare.com https://unpkg.com https://fonts.googleapis.com
# CSP_FONT_SRC='self' data: https://cdnjs.cloudflare.com https://fonts.gstatic.com
# CSP_IMG_SRC='self' data: blob: https://*.tile.openstreetmap.org https://unpkg.com
# CSP_CONNECT_SRC='self' https://*.tile.openstreetmap.org

# ---------- AUTHENTICATION ----------
IOT_USERNAME=admin
IOT_PASSWORD=CHANGE_ME_strong_password_min_8_chars

# ---------- DATABASE ----------
DB_PATH=database/iot.db
DATA_RETENTION_DAYS=30
ALERT_HISTORY_RETENTION_DAYS=90
STATUS_LOG_RETENTION_DAYS=30
ATTENDANCE_RETENTION_DAYS=365

# ---------- BACKUP ----------
BACKUP_ENABLED=True
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=backup

# ---------- DEVICE MONITORING ----------
# Fallback kalau device tidak punya expected_interval & offline_timeout
OFFLINE_TIMEOUT=900
CHECK_INTERVAL=60
DEFAULT_EXPECTED_INTERVAL=60
DEFAULT_OFFLINE_SEVERITY=danger
BACKGROUND_TASKS_ENABLED=True

# ---------- CORS ----------
# Pisah dengan koma. '*' DITOLAK demi keamanan.
CORS_ORIGINS=http://localhost:5000

# ---------- RATE LIMITING ----------
RATE_LIMIT_DEFAULT=200 per minute
RATE_LIMIT_DATA=60 per minute
RATE_LIMIT_LOGIN=5 per minute
RATE_LIMIT_REGENERATE=10 per minute
RATE_LIMIT_STORAGE=memory://

# ---------- LOGGING ----------
LOG_LEVEL=INFO
LOG_FILE=logs/nexus.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ---------- ALERT THRESHOLDS (hanya temperature) ----------
ALERT_TEMP_HEALTHY_MIN=6
ALERT_TEMP_HEALTHY_MAX=28
ALERT_TEMP_WARNING_MIN=0
ALERT_TEMP_WARNING_MAX=32
ALERT_TEMP_DANGER_MIN=-10
ALERT_TEMP_DANGER_MAX=40

# ---------- NOTIFICATIONS (TELEGRAM) ----------
NOTIFY_ENABLED=False
NOTIFY_MIN_SEVERITY=warning
NOTIFY_ON_CLEARED=True
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- AI CHAT (LLM / OpenAI-compatible) ----------
# WAJIB di-set kalau fitur NEXUS AI dipakai.
# Contoh OpenRouter: https://openrouter.ai/api/v1
# Contoh Hermes lokal: http://localhost:8000/v1
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=sk-no-key
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_TIMEOUT=120

# ---------- FILE LOCK (internal background tasks) ----------
# Direktori untuk lock file multi-worker Gunicorn.
# WAJIB shared antar-worker. Jangan pakai /tmp di container terpisah.
NEXUS_LOCK_DIR=/tmp