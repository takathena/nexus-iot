# ==========================================
# NEXUS IoT Configuration
# Copy file ini ke .env dan sesuaikan
# ==========================================

# ---------- SERVER ----------
HOST=0.0.0.0
PORT=5000
FLASK_ENV=production
DEBUG=False
WORKERS=2
THREADS=4

# ---------- NGINX ----------
NGINX_PORT=5008

# ---------- SECURITY ----------
# Generate dengan: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32
SESSION_LIFETIME_HOURS=24
SESSION_COOKIE_SECURE=False

# ---------- AUTHENTICATION ----------
IOT_USERNAME=admin
IOT_PASSWORD=change-me-to-strong-password

# ---------- DATABASE ----------
DB_PATH=database/iot.db
DATA_RETENTION_DAYS=30
BACKUP_ENABLED=True
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=backup

# ---------- DEVICE MONITORING ----------
OFFLINE_TIMEOUT=900
CHECK_INTERVAL=60

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5000,http://localhost:5008

# ---------- RATE LIMITING ----------
RATE_LIMIT_DEFAULT=200 per minute
RATE_LIMIT_DATA=60 per minute
RATE_LIMIT_LOGIN=5 per minute

# ---------- LOGGING ----------
LOG_LEVEL=INFO
LOG_FILE=logs/nexus.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ---------- ALERTS ----------
ALERT_TEMP_MIN=0
ALERT_TEMP_MAX=40
ALERT_HUMIDITY_MIN=20
ALERT_HUMIDITY_MAX=90
ALERT_GAS_MAX=70