# ==========================================
# NEXUS IoT - Environment Configuration
# ==========================================
# Copy file ini ke .env, lalu edit value-nya.
# Generate SECRET_KEY: python3 -c "import secrets; print(secrets.token_hex(32))"
# ==========================================

# ---------- SERVER ----------
HOST=0.0.0.0
PORT=5000
FLASK_ENV=production
DEBUG=False
WORKERS=2
THREADS=4

# ---------- SECURITY ----------
# WAJIB minimal 32 karakter, JANGAN pakai default
SECRET_KEY=CHANGE_ME_GENERATE_WITH_python3_-c_import_secrets_print_secrets_token_hex_32
SESSION_COOKIE_SECURE=False
SESSION_LIFETIME_HOURS=24

# ---------- AUTHENTICATION ----------
IOT_USERNAME=admin
IOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---------- DATABASE ----------
DB_PATH=database/iot.db
DATA_RETENTION_DAYS=30

# Backup
BACKUP_ENABLED=True
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=backup

# ---------- DEVICE MONITORING (GLOBAL DEFAULTS) ----------
# Nilai ini jadi fallback kalau device tidak punya config sendiri
OFFLINE_TIMEOUT=900
CHECK_INTERVAL=60
DEFAULT_EXPECTED_INTERVAL=60
DEFAULT_OFFLINE_SEVERITY=danger

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5000,http://localhost:5008

# ---------- RATE LIMITING ----------
RATE_LIMIT_DEFAULT=200 per minute
RATE_LIMIT_DATA=60 per minute
RATE_LIMIT_LOGIN=5 per minute

# ---------- LOGGING ----------
LOG_LEVEL=INFO
LOG_FILE=logs/nexus.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ---------- ALERT RULES (GLOBAL DEFAULT) ----------
# Format baru: healthy / warning / danger
# Device bisa override ini dengan custom rules via API
ALERT_TEMP_HEALTHY_MIN=6
ALERT_TEMP_HEALTHY_MAX=28
ALERT_TEMP_WARNING_MIN=0
ALERT_TEMP_WARNING_MAX=32
ALERT_TEMP_DANGER_MIN=-10
ALERT_TEMP_DANGER_MAX=40

# ---------- NGINX ----------
NGINX_PORT=5008