# ==========================================================
# NEXUS IoT — Environment Variables Example
# ==========================================================
# Copy file ini ke .env dan isi nilai yang sesuai:
#   cp .env.example .env
#
# Generate SECRET_KEY:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# ==========================================================

# ---------- SERVER ----------
HOST=0.0.0.0
PORT=5000
# production tidak lagi memaksa SESSION_COOKIE_SECURE=True; nilainya dari env (lihat di bawah)
# development = debug mode, cookie non-secure (untuk HTTP/lokal)
FLASK_ENV=production
DEBUG=False
# Port publik Nginx (reverse proxy di luar Python). Firmware ESP32 & dashboard lewat port ini.
# Port Flask internal (PORT) tetap 5000 di Docker; jangan diubah kecuali nginx/Dockerfile ikut diubah.
NGINX_PORT=5008
# Jumlah worker Gunicorn (Docker). >1 worker + RATE_LIMIT_STORAGE=memory:// = kuota per-worker.
WEB_CONCURRENCY=2

# ---------- SECURITY ----------
# WAJIB: minimal 32 karakter, jangan pakai default
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32_min_32_chars
# True = cookie hanya dikirim lewat HTTPS. Jika kosong/tidak di-set, ikut ENABLE_HSTS.
# False = akses via http://<IP-LAN> tetap bisa login (hanya untuk jaringan tepercaya).
SESSION_COOKIE_SECURE=False
SESSION_LIFETIME_HOURS=24
SESSION_IDLE_TIMEOUT_MINUTES=120
# 2 MB default. Set lebih besar jika payload sensor besar (dalam bytes)
MAX_CONTENT_LENGTH=2097152
# Batas body khusus endpoint device POST /api/v1/data (byte). Lebih besar -> HTTP 413
DATA_MAX_BYTES=8192
# Aktifkan hanya jika sudah pakai HTTPS. Header HSTS hanya dikirim bila True.
ENABLE_HSTS=False
# True = CSP hanya report, tidak blokir (untuk debugging)
CSP_REPORT_ONLY=False

# ---------- CSP OVERRIDES (opsional) ----------
# Kosongkan untuk pakai default dari config.py
# CSP_SCRIPT_SRC='self' 'unsafe-inline' https://cdnjs.cloudflare.com https://unpkg.com https://cdn.jsdelivr.net https://fonts.googleapis.com
# CSP_STYLE_SRC='self' 'unsafe-inline' https://cdnjs.cloudflare.com https://unpkg.com https://fonts.googleapis.com
# CSP_FONT_SRC='self' data: https://cdnjs.cloudflare.com https://fonts.gstatic.com
# CSP_IMG_SRC='self' data: blob: https://*.tile.openstreetmap.org https://unpkg.com
# CSP_CONNECT_SRC='self' https://*.tile.openstreetmap.org

# ---------- AUTHENTICATION ----------
# IOT_USERNAME/IOT_PASSWORD HANYA seed admin pertama (saat tabel users kosong).
# Setelah itu ganti password lewat UI (Profil > Ganti Password); nilai .env diabaikan.
IOT_USERNAME=admin
# WAJIB: minimal 8 karakter, jangan pakai "admin", "password", atau "12345678"
IOT_PASSWORD=CHANGE_ME_strong_password_min_8_chars

# ---------- DATABASE ----------
DB_PATH=database/iot.db
DATA_RETENTION_DAYS=30
ALERT_HISTORY_RETENTION_DAYS=90
STATUS_LOG_RETENTION_DAYS=30
ATTENDANCE_RETENTION_DAYS=365

# ---------- BACKUP ----------
BACKUP_ENABLED=True
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
# Minimal backup iot_*.db terbaru yang selalu disimpan walau lewat retensi
BACKUP_MIN_KEEP=3
BACKUP_DIR=backup

# ---------- DEVICE MONITORING ----------
# Fallback kalau device tidak punya expected_interval & offline_timeout
OFFLINE_TIMEOUT=900
CHECK_INTERVAL=60
DEFAULT_EXPECTED_INTERVAL=60
DEFAULT_OFFLINE_SEVERITY=danger
BACKGROUND_TASKS_ENABLED=True

# ---------- CORS ----------
# WAJIB: origin frontend (bukan port Flask internal).
# Pisah dengan koma. '*' DITOLAK demi keamanan.
CORS_ORIGINS=http://localhost:5008,http://127.0.0.1:5008

# ---------- RATE LIMITING ----------
RATE_LIMIT_DEFAULT=200 per minute
# /data: limit utama per device_id (dari body JSON); plafon per IP mencegah rotasi device_id palsu
RATE_LIMIT_DATA=60 per minute
RATE_LIMIT_DATA_IP=600 per minute
RATE_LIMIT_LOGIN=5 per minute
RATE_LIMIT_REGENERATE=10 per minute
# memory:// untuk single worker, redis://host:6379/0 untuk multi-worker
RATE_LIMIT_STORAGE=memory://
# Throttle login gagal (tersimpan di DB, dibagi antar worker)
LOGIN_MAX_FAILURES=5
LOGIN_IP_MAX_FAILURES=20
LOGIN_FAIL_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# ---------- LOGGING ----------
LOG_LEVEL=INFO
LOG_FILE=logs/nexus.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ---------- ALERT THRESHOLDS (hanya temperature) ----------
ALERT_TEMP_HEALTHY_MIN=6
ALERT_TEMP_HEALTHY_MAX=28
ALERT_TEMP_WARNING_MIN=0
ALERT_TEMP_WARNING_MAX=32
ALERT_TEMP_DANGER_MIN=-10
ALERT_TEMP_DANGER_MAX=40

# ---------- NOTIFICATIONS (TELEGRAM) ----------
# Kalau NOTIFY_ENABLED=True, maka TELEGRAM_ENABLED harus True
# dan TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID wajib diisi.
NOTIFY_ENABLED=False
NOTIFY_MIN_SEVERITY=warning
NOTIFY_ON_CLEARED=True
TELEGRAM_ENABLED=False
# Dapatkan dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=
# Dapatkan dari @userinfobot atau chat ID grup (format: -1001234567890)
TELEGRAM_CHAT_ID=

# ---------- AI CHAT (LLM / OpenAI-compatible) ----------
# WAJIB di-set kalau fitur NEXUS AI dipakai.
#
# Contoh OpenRouter:   https://openrouter.ai/api/v1
# Contoh Ollama lokal: http://localhost:11434/v1
# Contoh vLLM:         http://localhost:8000/v1
# Contoh Hermes lokal: http://localhost:8000/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
# Dapatkan dari https://openrouter.ai/keys (format: sk-or-v1-xxx)
# Untuk Ollama/vLLM lokal bisa diisi "sk-no-key" atau apa saja
LLM_API_KEY=
# Contoh model: openrouter/free, meta-llama/llama-3.3-70b-instruct:free,
#               llama3.1:8b (Ollama), Qwen/Qwen2.5-7B-Instruct (vLLM)
LLM_MODEL=openrouter/free
LLM_TIMEOUT=120

# ---------- FILE LOCK (internal background tasks) ----------
# Direktori untuk lock file multi-worker Gunicorn.
# WAJIB shared antar-worker. Jangan pakai /tmp di container terpisah.
# Kalau pakai multi-container, arahkan ke volume shared:
#   NEXUS_LOCK_DIR=/app/locks
NEXUS_LOCK_DIR=/tmp